{
  "workbench.colorTheme": "One Dark Pro",
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontSize": 25,
  "editor.fontFamily": "JetBrains Mono NL",
  "editor.fontLigatures": true,
  "terminal.integrated.fontSize": 25,
  "terminal.integrated.fontFamily": "JetBrainsMonoNL Nerd Font Mono",
  "editor.tabSize": 4,
  "editor.formatOnSave": true,
  "telemetry.telemetryLevel": "off",
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "workbench.startupEditor": "none",
  "files.autoSave": "afterDelay",
  
  "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
  "java.configuration.updateBuildConfiguration": "automatic",
  "biome.lsp.bin": "/home/kirill/.local/bin/biome",
  "ruff.path": [
    "/home/kirill/.local/bin/ruff"
  ],
  "shellformat.path": "/usr/bin/shfmt",
  "shellformat.effectLanguages": [
    "shellscript"
  ],
  
  "yamlfmt.path": "/home/kirill/.local/bin/yamlfmt",
  
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },

  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[tsx]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[html]": {
    "editor.defaultFormatter": "mohd-akram.vscode-html-format"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[vue]": {
    "editor.defaultFormatter": "vue.volar"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "bluebrown.yamlfmt"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "bluebrown.yamlfmt"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  
  "terminal.integrated.profiles.linux": {
    "zsh": {
      "path": "/bin/zsh",
      "args": ["-l"]
    }
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}
